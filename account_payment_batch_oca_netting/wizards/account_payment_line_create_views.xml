<odoo>
    <record id="account_payment_line_create_view_form" model="ir.ui.view">
        <field name="model">account.payment.line.create</field>
        <field
            name="inherit_id"
            ref="account_payment_batch_oca.account_payment_line_create_form"
        />
        <field name="arch" type="xml">
            <field name="invoice" position="after">
                <field name="netting" invisible="1" />
                <field name="include_receivables" invisible="not netting" />
            </field>
        </field>
    </record>
</odoo>
