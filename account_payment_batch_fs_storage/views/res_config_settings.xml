<odoo>
    <record model="ir.ui.view" id="res_config_settings_form_view">
        <field
            name="name"
        >res.config.settings.form (in account_payment_batch_fs_storage)</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form" />
        <field name="priority" eval="100" />
        <field name="arch" type="xml">
            <xpath expr="//block[@id='quick_edit_mode']" position="after">
                <block
                    title="Origin of fs storage for payment"
                    name="payment_order_storage"
                >
                    <setting
                        string="FS Storage Source"
                        help="Select where the information about the storage is taken"
                        company_dependent="1"
                    >
                        <field name="fs_storage_source_payment" widget="radio" />
                    </setting>
                    <setting
                        string="Allowed Storages"
                        help="Select the storages allowed for payment orders"
                        company_dependent="1"
                    >
                        <field name="fs_storage_ids" widget="many2many_tags" />
                    </setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
